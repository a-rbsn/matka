# The demo's settings: copy to .env. Only the Stripe ones are needed to try a real checkout.

# Stripe test mode: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Printed by `npm run stripe:listen` (it stays the same between runs).
STRIPE_WEBHOOK_SECRET=whsec_...

# Where rolls are kept: memory (default; lost on restart), blobs (a local Netlify Blobs server,
# kept in .netlify/matka-blobs) or supabase (needs the two below; `supabase start` here runs
# one on port 55321 with the table made).
MATKA_STORE=memory
# SUPABASE_URL=http://127.0.0.1:55321
# SUPABASE_SERVICE_ROLE_KEY=

# Every roll lands on this face (dev only): try a win without buying six prints.
# MATKA_FORCE_FACE=6
